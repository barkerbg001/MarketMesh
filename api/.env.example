# Copy to api/.env and adjust. Never commit api/.env.

# --- Django ---
# Required in production (config.settings.production). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Defaults: development=true, production=false. Leave unset unless you need to override.
# DEBUG=true
# Comma-separated. Development default: localhost,127.0.0.1,[::1]. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to send CSRF-protected requests to the admin
# (needed when the admin is served behind HTTPS on a custom domain).
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Johannesburg
LOG_LEVEL=INFO

# --- Database (SQLite) ---
# Relative paths are resolved from the api/ directory.
SQLITE_PATH=db.sqlite3
# Record each search/scrape run (query, outcome, products) for the admin.
SEARCH_HISTORY_ENABLED=true

# --- CORS ---
# Comma-separated (a JSON array also works). Not needed when the web app uses the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI agents (OpenRouter) ---
# The usual way to configure OpenRouter is the in-app Settings page, which stores
# the key encrypted in the database. These variables are an optional fallback used
# only while no key has been saved in Settings. Product search works without a key.
OPEN_ROUTER_API_KEY=
# Optional fallback model ID (pick one from https://openrouter.ai/models that
# supports tool calling). Leave empty to choose a model in Settings; there is no
# built-in default.
OPEN_ROUTER_MODEL=
OPEN_ROUTER_REFERER=http://localhost:5173

# --- Encryption of saved API keys ---
# Fernet key used to encrypt the OpenRouter key saved from Settings. It lives
# outside the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, development creates api/.secrets/encryption.key on first use
# (gitignored). Production requires this variable unless
# MARKETMESH_ENCRYPTION_KEY_AUTOCREATE=true. Changing or losing the key makes the
# saved OpenRouter key unreadable; re-enter it in Settings.
MARKETMESH_ENCRYPTION_KEY=
# MARKETMESH_ENCRYPTION_KEY_FILE=.secrets/encryption.key

# --- Scraping (Playwright) ---
# false shows the browser window (development default); production defaults to true.
PLAYWRIGHT_HEADLESS=false

# --- Production security (config.settings.production only) ---
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=false
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# USE_X_FORWARDED_PROTO=false
