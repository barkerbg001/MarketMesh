# Copy to web/.env.local to override. All values are optional.

# Where the Vite dev server proxies /api requests (development only).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Absolute API origin baked into production builds when the web app is served
# from a different origin than the API. Leave unset to call /api on the same origin.
# The API's CORS_ORIGINS must include the web app's origin when this is set.
# VITE_API_BASE_URL=https://api.example.com
